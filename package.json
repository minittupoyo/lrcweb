{
  "name": "lrcweb",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && bun run typecheck && bun run test",
    "check:fix": "biome check --write .",
    "test": "bun test src/lib",
    "test:watch": "bun test --watch src/lib",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "version": "0.1.0",
  "description": "A local-first Japanese LRC lyrics editor with audio synchronization and LRCLIB search.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
